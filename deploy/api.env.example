# Copy to api/.env on the droplet and fill in (`cp deploy/api.env.example api/.env`).
# Reconciled against the real api/.env.example in this checkout — only the subset
# relevant to a self-hosted, single-tenant instance is kept. Anything left blank
# below is fine to leave blank for self-hosting (billing, analytics, etc).

PORT=3001
NODE_ENV=production

# MongoDB Atlas connection string (Atlas UI: cluster > Connect > Drivers).
# Create a dedicated DB user for this app; don't reuse the Atlas admin user.
# Note: no MONGO_ROOT_USER/MONGO_ROOT_PASS needed — those are only for the
# docker-compose-managed local Mongo container, which we're not using.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/textbee?retryWrites=true&w=majority

# Redis runs locally on the droplet (apt install redis-server), bound to 127.0.0.1 only.
USE_SMS_QUEUE=true
REDIS_URL=redis://127.0.0.1:6379

# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=60d

# Public dashboard URL (matches web/.env NEXT_PUBLIC_SITE_URL)
FRONTEND_URL=https://sms.zupa.work
# Public URL of this API itself, used in email links.
API_PUBLIC_URL=https://sms.zupa.work/api/v1
APP_PUBLIC_URL=https://sms.zupa.work

# Full contents of the Firebase service account JSON (Project Settings > Service
# Accounts > Generate new private key). FIREBASE_PRIVATE_KEY must keep its \n
# escapes (wrap in quotes as a single line) or the SDK will fail to parse it.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_C509_CERT_URL=

# SMTP for the account-verification email (sending SMS requires a verified account)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
ADMIN_EMAIL=

# Cloudflare Turnstile (captcha on signup). The upstream default below is
# Cloudflare's public test key — it always passes and is fine for an internal,
# non-public-signup instance. Swap for a real site/secret pair if this
# dashboard will ever be open to untrusted signups.
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Leave unset: no Google sign-in needed for an internal instance.
GOOGLE_CLIENT_ID=

# Leave unset: Polar billing / Meta analytics are SaaS-only concerns, not used self-hosted.
# POLAR_ACCESS_TOKEN=
# ANALYTICS_PROVIDERS=
