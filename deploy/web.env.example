# Copy to web/.env on the droplet and fill in (`cp deploy/web.env.example web/.env`).
# NEXT_PUBLIC_* values are baked in at build time: changing them requires `pnpm build` again.

NEXT_PUBLIC_SITE_URL=https://sms.zupa.work
NEXT_PUBLIC_API_BASE_URL=https://sms.zupa.work/api/v1
# Keep in sync with the API's LATEST_APP_VERSION_CODE/NAME once a custom APK is built.
NEXT_PUBLIC_LATEST_APP_VERSION_CODE=20
NEXT_PUBLIC_LATEST_APP_VERSION_NAME=2.9.0

# Leave unset: no Google sign-in needed for an internal instance.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Used by NextAuth to sign/verify the session JWT.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://sms.zupa.work

MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
ADMIN_EMAIL=

# Cloudflare Turnstile (captcha on signup/login forms). Cloudflare's public test
# site key below always passes — fine for an internal instance. Swap for a real
# key if the dashboard is ever exposed to untrusted signups.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Leave unset: no third-party analytics needed for an internal instance.
NEXT_PUBLIC_ANALYTICS_PROVIDERS=
